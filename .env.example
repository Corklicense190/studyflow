# Copia este archivo a ".env" (que nunca se sube al repo) y ajusta
# los valores según tu entorno local.

# Puerto donde escucha el servidor Express.
PORT=3000

# Secreto con el que se firma la cookie de sesión. Pon una cadena larga
# y aleatoria (mínimo 32 caracteres). Puedes generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no lo defines, el servidor usa uno aleatorio en cada arranque
# (funciona, pero las sesiones abiertas se cierran al reiniciarlo).
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Solo para despliegue (Railway u otro proveedor):
#   NODE_ENV=production      -> exige un SESSION_SECRET fuerte o no arranca
#   TRUST_PROXY=1            -> número de proxies delante de la app (1 en Railway)
#   DB_PATH=/data/studyflow.db  -> archivo SQLite dentro de un volumen persistente
#                                  (en Railway se detecta solo si adjuntas un volumen)
# En local NO los definas.

# Cookie de sesión solo por HTTPS. Déjalo en false para correr en local
# (http://localhost); ponlo en true cuando se despliegue detrás de HTTPS.
COOKIE_SEGURA=false
