# Copia este archivo a ".env" (que nunca se sube al repo) y ajusta
# los valores según tu entorno local.

# Puerto donde escucha el servidor Express en local.
PORT=3000

# ── Base de datos (PostgreSQL / Supabase) ────────────────────
# Cadena de conexión. En Supabase: botón "Connect" -> "Transaction
# pooler" (puerto 6543, el que sirve para entornos serverless como
# Vercel). Sustituye [YOUR-PASSWORD] por la contraseña de tu base.
# NO le pongas "?sslmode=..." (el cifrado se configura en el código).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Certificado raíz de Supabase (Supabase -> Database Settings -> SSL
# Configuration -> Download certificate). Pega TODO el contenido del
# archivo .crt (en una variable de Vercel se puede pegar en varias líneas).
# Con esto se VERIFICA la identidad del servidor de base de datos; sin
# él la conexión va cifrada pero sin verificar.
#DATABASE_CA=

# ── Solo para desarrollo local con Docker (docker-compose.yml) ──
# Descomenta estas 3 líneas y comenta la DATABASE_URL de Supabase de arriba.
#DATABASE_URL=postgresql://postgres:desarrollo@localhost:54329/studyflow
#DATABASE_SSL=false
#MIGRAR_AL_ARRANCAR=true

# ── Sesiones ─────────────────────────────────────────────────
# Secreto con el que se firma la cookie de sesión. Pon una cadena larga
# y aleatoria (mínimo 32 caracteres). Puedes generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no lo defines en local, el servidor usa uno aleatorio en cada arranque
# (funciona, pero las sesiones abiertas se cierran al reiniciarlo). En
# PRODUCCIÓN es obligatorio: sin él el servidor no arranca.
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# ── Solo para producción (Vercel) ────────────────────────────
# En local NO los definas.
#   NODE_ENV=production   (Vercel ya lo pone solo)
#   COOKIE_SEGURA=true    -> la cookie de sesión solo viaja por HTTPS
#   TRUST_PROXY=1         -> número de proxies delante de la app (1 en Vercel)
COOKIE_SEGURA=false
